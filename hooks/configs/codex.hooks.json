{
  "description": "Guards e observabilidade do kit Skills. Codex exige revisão manual: rode /hooks na CLI para confiar nos hooks (ele guarda o hash de cada definição). Docs: developers.openai.com/codex/hooks",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOKS__/guard-dangerous.py",
            "statusMessage": "checando comando",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 __HOOKS__/guard-secrets.py",
            "statusMessage": "checando arquivo",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash __HOOKS__/auto-format.sh", "timeout": 20 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash __HOOKS__/audit-log.sh", "async": true, "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash __HOOKS__/session-context.sh",
            "additionalContextLimit": 4000,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash __HOOKS__/notify-stop.sh", "async": true, "timeout": 10 }
        ]
      }
    ]
  }
}
